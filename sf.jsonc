{
  "$schema": "https://spacefast.com/schemas/sf.schema.json",
  "name": "f.camera",
  "meta": {
    "title": "f.camera — photographs",
    "favicon": "/assets/favicon.svg",
    "description": "Photographs by humans, not AI. A personal photo collection by Fatih Kadir Akın, with a Fujifilm X-S20 and an iPhone camera.",
  },
  "build": {
    "buildCommand": "node scripts/build-static.mjs",
    "outputDirectory": "dist",
  },
  "runtime": {
    "kind": "zero",
    "server": "server/index.ts",
    "client": "client/index.tsx",
  },
}
